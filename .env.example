# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (on Render this is wired automatically from
# the finvois-db database defined in render.yaml).
DATABASE_URL=postgresql://user:password@host:5432/finvois

# Your own Anthropic API key (https://console.anthropic.com → API Keys).
# Powers DPR extraction, executive summaries, and section verdicts.
ANTHROPIC_API_KEY=sk-ant-...

# Port the server listens on (Render sets this automatically).
PORT=5000

# ── Optional ────────────────────────────────────────────────────────────────

# Session signing secret (any long random string).
SESSION_SECRET=change-me-to-a-long-random-string

# Override the directory of the built frontend if you move it.
# Default: artifacts/finvois/dist/public (relative to the server bundle).
# PUBLIC_DIR=

# ── Replit-only (not needed on Render) ──────────────────────────────────────
# When ANTHROPIC_API_KEY is NOT set, the app falls back to the Replit-managed
# AI proxy using these variables (auto-provided inside Replit):
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=
